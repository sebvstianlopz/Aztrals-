---
// Dev-only page (see astro.config.mjs): renders the home hero's frame sequence. The season's
// four pairs start folded in a pile; scrolling lifts each one in turn, opens it towards the
// visitor and sends it up out of the frame (src/three/stack.ts).
// scripts/render-hero.mjs saves the frames to public/hero/frames/.
import { getProducts } from '../src/lib/products';
import { HERO_FRAMES } from '../src/lib/hero';
const season = (await getProducts()).filter((p) => p.data.season).slice(0, 4);
const pairs = season.map((p) => ({ shape: p.data.shape, frame: p.data.variants[0].frame, lens: p.data.variants[0].lens }));
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><title>Render hero</title>
    <style>body{margin:0;background:#fff}canvas{width:1200px;height:900px;display:block}</style>
  </head>
  <body>
    <canvas id="c" width="1200" height="900"></canvas>
    <script type="application/json" id="pairs" set:html={JSON.stringify({ pairs, frames: HERO_FRAMES })} />
    <script>
      import '@fontsource/unifrakturmaguntia/latin-400.css';
      import { PileScene } from '../src/three/stack';
      import { spec, type FrameId, type LensId, type Shape } from '../src/lib/palette';
      const { pairs, frames } = JSON.parse(document.getElementById('pairs')!.textContent!) as {
        pairs: { shape: Shape; frame: FrameId; lens: LensId }[];
        frames: number;
      };
      const scene = new PileScene(document.getElementById('c') as HTMLCanvasElement, pairs.map((p) => spec(p.shape, p.frame, p.lens)));
      const save = (window as any).saveFrame as (n: number, data: string) => Promise<void>;
      const only = new URLSearchParams(location.search).get('at');
      (async () => {
        await document.fonts.load('400 92px "UnifrakturMaguntia"');
        if (only) {
          // Preview a few points: ?at=0,0.1,0.2
          for (const [i, p] of only.split(',').map(Number).entries()) {
            scene.pose(p);
            await save(i + 1, scene.snapshot());
          }
        } else {
          for (let i = 0; i < frames; i++) {
            scene.pose(i / (frames - 1));
            await save(i + 1, scene.snapshot());
          }
        }
        document.title = 'done';
      })();
    </script>
  </body>
</html>
