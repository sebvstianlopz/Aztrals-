---
// The loading screen: shown once per browser session, over the page from the first paint.
// The name scrambles into place, its letters turn into dots and sparkles that curl into a spinning
// ring while the page loads, and the ring flies into the logo's starburst as the logo is drawn in.
// The choreography is in src/scripts/intro.ts; the logo shapes are in src/components/brand/logo.ts.
import { t } from '../i18n';
import type { Lang } from '../config/site';
import { logo } from './brand/logo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).intro;
const viewBox = `0 0 ${logo.width} ${logo.height}`;
const letters = 'AZTRALS'.split('');
---
<div class="intro" data-intro role="dialog" aria-modal="true" aria-label={d.label}>
  <p class="intro__word condensed" aria-hidden="true" data-intro-word>
    {letters.map((ch) => <span data-ch={ch}>{ch}</span>)}
  </p>
  <div class="intro__dots" aria-hidden="true" data-intro-dots>
    {letters.map((_, i) => <i class:list={['intro__dot', i % 2 ? 'is-spark' : 'is-dot']}></i>)}
  </div>
  <div class="intro__logo" role="img" aria-label="Aztrals" data-intro-logo style={`--logo-ratio: ${logo.width} / ${logo.height}`}>
    <svg class="intro__layer intro__lettering" viewBox={viewBox} aria-hidden="true" data-intro-lettering>
      <path fill="currentColor" fill-rule="evenodd" d={logo.word} />
    </svg>
    <svg class="intro__layer" viewBox={viewBox} aria-hidden="true">
      <path fill="currentColor" fill-rule="evenodd" d={logo.burstPath} data-intro-burst />
    </svg>
    <svg class="intro__layer intro__sparks" viewBox={viewBox} aria-hidden="true">
      {logo.sparks.map((p) => <path d={p} data-intro-spark />)}
    </svg>
  </div>
</div>

<style>
  .intro {
    /* The logo's own sparkle yellow, used only here. */
    --logo-yellow: #f6d21c; /* taste-skill-ignore: brand logo colour */
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    background: var(--black);
    color: var(--white);
    overflow: hidden;
    transition: transform 900ms var(--ease-in-out);
  }
  :global(html.intro-on) .intro {
    display: block;
    /* If the script never runs, the loading screen still gets out of the way. */
    animation: intro-fallback 0s 10s forwards;
  }
  :global(html.intro-leaving) .intro {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .intro {
      transition: opacity 400ms ease;
    }
    :global(html.intro-leaving) .intro {
      transform: none;
      opacity: 0;
    }
    /* With reduced motion the logo simply shows, then fades. */
    .intro .intro__word,
    .intro .intro__dots {
      display: none;
    }
    .intro .intro__logo {
      visibility: visible;
    }
  }
  @keyframes intro-fallback {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* Everything is centred on the screen; the script moves pieces from there. */
  .intro__word,
  .intro__logo {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    margin: 0;
  }
  .intro__word {
    display: flex;
    font-size: clamp(3.5rem, 17vw, 9.5rem);
    white-space: nowrap;
  }
  .intro__word span {
    display: inline-block;
    min-width: 0.55em;
    text-align: center;
  }
  .intro__dots {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
  }
  .intro__dot {
    --size: clamp(12px, 2.6vw, 20px);
    position: absolute;
    left: calc(var(--size) / -2);
    top: calc(var(--size) / -2);
    width: var(--size);
    height: var(--size);
    background: var(--white);
    opacity: 0;
  }
  .intro__dot.is-dot {
    border-radius: 50%;
  }
  /* A four-point sparkle, like the ones around the logo. */
  .intro__dot.is-spark {
    background: var(--logo-yellow);
    clip-path: polygon(50% 0, 63% 37%, 100% 50%, 63% 63%, 50% 100%, 37% 63%, 0 50%, 37% 37%);
    scale: 1.6;
  }
  .intro__logo {
    width: min(540px, 82vw);
    aspect-ratio: var(--logo-ratio);
    visibility: hidden;
  }
  .intro__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .intro__sparks {
    fill: var(--logo-yellow);
  }
  /* The lettering is drawn in from left to right, like the comet streaking into its star. */
  .intro__lettering {
    --wipe: 120%;
    mask-image: linear-gradient(90deg, #000 calc(var(--wipe) - 18%), transparent var(--wipe));
  }
</style>
