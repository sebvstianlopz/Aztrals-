---
// One picture slot. With a photo it renders a responsive <picture>; without one it shows the
// drawing passed in the default slot on a flat tone, at the same proportions.
import { Picture } from 'astro:assets';

interface Props {
  photo?: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio, e.g. "4 / 5". */
  ratio: string;
  tone?: 'bone' | 'stone' | 'sand' | 'night' | 'none';
  sizes?: string;
  widths?: number[];
  fit?: 'cover' | 'contain';
  loading?: 'lazy' | 'eager';
  class?: string;
}
const {
  photo,
  alt,
  ratio,
  tone = 'stone',
  sizes = '(min-width: 900px) 50vw, 100vw',
  widths = [480, 800, 1200, 1600, 2000],
  fit = 'cover',
  loading = 'lazy',
  class: cls,
} = Astro.props;
// Every listed width the photo can fill, plus the photo's own width so large screens get the original.
const usable = photo ? [...new Set([...widths.filter((w) => w < photo.width), photo.width])] : [];
---
<div class:list={['shot', `shot--${tone}`, cls]} style={`--ratio:${ratio}`} data-pending={photo ? undefined : ''}>
  {
    photo ? (
      <Picture
        src={photo}
        alt={alt}
        widths={usable}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : undefined}
        class:list={['shot__img', `shot__img--${fit}`]}
      />
    ) : (
      <div class="shot__draw" role="img" aria-label={alt}>
        <slot />
      </div>
    )
  }
</div>

<style>
  .shot {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    isolation: isolate;
  }
  .shot--bone {
    background: var(--bone);
  }
  .shot--stone {
    background: var(--slot);
  }
  .shot--sand {
    background: var(--slot-2);
  }
  .shot--night {
    background: var(--slot-dark);
  }
  .shot :global(picture),
  .shot :global(.shot__img) {
    width: 100%;
    height: 100%;
  }
  .shot :global(.shot__img--cover) {
    object-fit: cover;
  }
  .shot :global(.shot__img--contain) {
    object-fit: contain;
  }
  .shot__draw {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
</style>
