---
import Shot from './Shot.astro';
import Glasses from './Glasses.astro';
import { t, path, formatPrice } from '../i18n';
import { productPhotos, type Product } from '../lib/products';
import { frameColor, tintColor } from '../lib/swatches';
import type { Lang } from '../config/site';

interface Props {
  product: Product;
  lang: Lang;
  /** Picture proportions for this tile. */
  ratio?: string;
  add?: boolean;
  sizes?: string;
  class?: string;
}
const { product, lang, ratio = '1 / 1', add = false, sizes = '(min-width: 900px) 25vw, 50vw', class: cls } = Astro.props;
const d = t(lang);
const p = product.data;
const first = p.colorways[0];
// One picture layer per colourway; the colour dots switch between them.
const layers = p.colorways.map((c) => ({ c, photo: productPhotos(product.id, c.id)[0] }));
const url = path(lang, 'shop', product.id);
---
<article
  class:list={['tile', cls]}
  data-tile
  data-new={p.isNew ? '' : undefined}
  data-sport={p.sport ? '' : undefined}
  data-polarized={p.lens.polarized ? '' : undefined}
>
  <a class="tile__media" href={url} tabindex="-1" aria-hidden="true" data-tile-media>
    <span class="tile__layers" data-tile-layers>
      {
        layers.map(({ c, photo }, i) => (
          <span class="tile__layer" data-tile-layer={c.id} data-active={i === 0 ? '' : undefined}>
            <Shot photo={photo} alt={`${p.name}, ${c.name[lang]}`} ratio={ratio} tone="stone" sizes={sizes}>
              <Glasses class="tile__draw" shape={p.shape} frame={c.frame} tint={c.tint} mirror={p.lens.mirror} />
            </Shot>
          </span>
        ))
      }
    </span>
  </a>
  <div class="tile__meta">
    <h3 class="tile__name"><a href={url}>{p.name}</a></h3>
    <span class="price">{formatPrice(p.price, lang)}</span>
  </div>
  <div class="tile__foot">
    <span class="tile__dots small muted">
      <span class="dots" role="group" aria-label={`${p.name}: ${d.card.colorLabel}`}>
        {
          p.colorways.map((c, i) => (
            <button
              type="button"
              class="dot"
              data-tile-dot={c.id}
              data-name={c.name[lang]}
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={c.name[lang]}
              style={`--f:${frameColor[c.frame]};--t:${tintColor[c.tint]}`}
            >
              <i />
            </button>
          ))
        }
      </span>
      <span class="tile__count">{d.card.colors(p.colorways.length)}</span>
    </span>
    {
      add && (
        <button class="tile__add" type="button" data-add={product.id} data-colorway={first.id} data-added={d.card.added}>
          <span data-label>{d.card.add}</span>
          <span class="sr-only" data-tile-cwname>
            {' '}
            {p.name}, {first.name[lang]}
          </span>
        </button>
      )
    }
  </div>
</article>

<style>
  .tile {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 12px;
    align-content: start;
  }
  .tile__media {
    display: block;
    border-radius: var(--radius-tile);
    overflow: hidden;
  }
  .tile__media :global(.shot) {
    transition: transform 700ms var(--ease-out);
  }
  .tile__media :global(.shot__draw svg),
  .tile__media :global(.shot__img) {
    transition: transform 700ms var(--ease-out);
  }
  .tile__draw {
    width: 72%;
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover .tile__media :global(.shot__draw svg),
    .tile:hover .tile__media :global(.shot__img) {
      transform: scale(1.05);
    }
  }
  .tile__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 12px;
  }
  .tile__meta .price {
    white-space: nowrap;
  }
  .tile__name {
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.2;
    overflow-wrap: break-word;
    min-width: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .tile__name a {
    text-decoration: none;
  }
  .tile__name a:focus-visible {
    outline: none;
  }
  .tile:has(.tile__name a:focus-visible) .tile__media {
    outline: 2px solid var(--sun);
    outline-offset: 3px;
  }
  .tile__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: -6px;
  }
  .tile__dots {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dots {
    display: inline-flex;
    margin-left: -5px;
  }
  /* Each colour is a 24px button around a 14px dot (frame ring, lens centre). */
  .dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }
  .dot i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--t);
    border: 3px solid var(--f);
    transition: transform 200ms var(--ease-out);
  }
  .dot[aria-pressed='true'] i {
    transform: scale(1.25);
  }
  @media (hover: hover) and (pointer: fine) {
    .dot:hover i {
      transform: scale(1.25);
    }
  }
  .dot:focus-visible {
    outline-offset: 0;
  }
  /* Colour layers: crossfade with a slight blur, so it reads as one object changing colour. */
  .tile__layers {
    display: grid;
  }
  .tile__layer {
    grid-area: 1 / 1;
    opacity: 0;
    filter: blur(3px);
    transition:
      opacity 320ms ease,
      filter 320ms ease;
  }
  .tile__layer[data-active] {
    opacity: 1;
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile__layer {
      transition: none;
      filter: none;
    }
  }
  .tile__add {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--bone-2);
    font-size: var(--step-small);
    font-weight: 560;
    transition:
      transform 160ms var(--ease-out),
      background-color 200ms ease,
      color 200ms ease;
  }
  .tile__add:active {
    transform: scale(0.96);
  }
  .tile__add[data-state='added'] {
    background: var(--purple);
    color: var(--white);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile__add:hover {
      background: var(--bone-3);
    }
    .tile__add[data-state='added']:hover {
      background: var(--purple);
    }
  }
</style>
