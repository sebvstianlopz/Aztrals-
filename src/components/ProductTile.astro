---
// A product card: the pair on soft grey, a badge, name, lens, colours and price,
// and a small picture of each colourway that switches the card.
import { t, path } from '../i18n';
import type { Lang } from '../config/site';
import { money, variantName, type ClientProduct } from '../lib/products';
import { shapeNames } from '../lib/palette';
interface Props { lang: Lang; product: ClientProduct; data: { polarized: boolean; order: number }; eager?: boolean; size?: 'large' | 'small' }
const { lang, product: p, data, eager = false, size = 'large' } = Astro.props;
const d = t(lang);
const v0 = p.variants[0];
const url = p.url[lang];
---
<li
  class={`tile ${size}`}
  data-shape={p.shape}
  data-lenses={[...new Set(p.variants.map((v) => v.lens))].join(' ')}
  data-season={p.season ? '1' : '0'}
  data-price={p.price}
  data-order={data.order}
>
  <a class="pic" href={`${url}?v=${v0.id}`} tabindex="-1" aria-hidden="true">
    <img class="main" src={v0.pics.main} alt="" width="960" height="720" loading={eager ? 'eager' : 'lazy'} />
    {v0.pics.front && <img class="alt" src={v0.pics.front} alt="" width="960" height="720" loading="lazy" />}
  </a>
  {size === 'large' && p.variants.length > 1 && (
    <div class="thumbs" role="group" aria-label={d.product.variant}>
      {p.variants.map((v, i) => (
        <button type="button" class="thumb" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={variantName(v, lang)} title={variantName(v, lang)} data-main={v.pics.main} data-front={v.pics.front ?? ''} data-href={`${url}?v=${v.id}`}>
          <img src={v.pics.main} alt="" width="960" height="720" loading="lazy" />
        </button>
      ))}
    </div>
  )}
  <div class="info">
    {size === 'large' && p.badge && <span class="badge caps">{d.badge[p.badge as keyof typeof d.badge]}</span>}
    <h3 class="name"><a href={`${url}?v=${v0.id}`}>{p.name}</a></h3>
    {size === 'large' && <p class="line">{shapeNames[p.shape][lang]}{data.polarized ? ` · ${d.shop.polarized}` : ''}</p>}
    {size === 'large' && <p class="line grey">{d.shop.colours(p.variants.length)}</p>}
    <p class="price num">{money(p.price, lang)}</p>
  </div>
</li>

<style>
  .tile { display: grid; align-content: start; }
  .pic { position: relative; display: block; aspect-ratio: 1 / 1; background: var(--soft); border-radius: 4px; overflow: hidden; }
  .pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 6%; transition: transform 900ms var(--ease), opacity 500ms var(--ease); }
  .pic .alt { opacity: 0; }
  .tile:hover .pic .main { transform: scale(1.05); }
  .tile:hover .pic:has(.alt) .main { opacity: 0; }
  .tile:hover .pic .alt { opacity: 1; }
  .thumbs { display: flex; gap: 6px; margin-top: 10px; }
  .thumb { width: 56px; aspect-ratio: 1; padding: 0; border: 1px solid transparent; background: var(--soft); border-radius: 2px; transition: border-color var(--fast) var(--ease); }
  .thumb img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }
  .thumb:hover { border-color: var(--line); }
  .thumb[aria-pressed='true'] { border-color: var(--ink); }
  .info { display: grid; gap: 2px; justify-items: start; margin-top: 14px; }
  .badge { font-size: 0.6875rem; padding: 4px 8px; background: var(--ink); color: var(--white); border-radius: 2px; margin-bottom: 8px; letter-spacing: 0.12em; }
  .name { font-family: var(--sans); font-size: 1.125rem; font-weight: 500; letter-spacing: 0.01em; line-height: 1.3; }
  .name a { text-decoration: none; }
  .name a:hover { opacity: 0.6; }
  .line { font-size: var(--t-small); }
  .price { font-size: 1rem; margin-top: 6px; }
  /* Small: the GIADA-style collection grid, centred, on white */
  .small .pic { background: transparent; }
  .small .info { justify-items: center; text-align: center; margin-top: 4px; }
  .small .name { font-family: var(--serif); font-size: 1.375rem; font-weight: 400; }
  .small .price { margin-top: 0; color: var(--grey); }
</style>
