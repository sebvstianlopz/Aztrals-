---
// Flat drawings of the places the season's pairs are named after, in one graphic language:
// a sky, the sun, the sea in bands and one landmark. They stand in for photographs.
interface Props { place: 'condado' | 'culebra' | 'rincon' | 'vieques'; class?: string; label: string }
const { place, class: cls, label } = Astro.props;
---
<svg class={cls} viewBox="0 0 400 600" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
  {place === 'condado' && (
    <g>
      <rect width="400" height="600" fill="#f2e3cb" />
      <circle cx="306" cy="132" r="40" fill="#f0b46e" />
      <g fill="#dcc1a0">
        <rect x="8" y="196" width="46" height="148" />
        <rect x="106" y="176" width="54" height="168" />
        <rect x="214" y="208" width="62" height="136" />
        <rect x="330" y="228" width="58" height="116" />
      </g>
      <g fill="#c9a681">
        <rect x="58" y="246" width="40" height="98" />
        <rect x="166" y="262" width="40" height="82" />
        <rect x="282" y="258" width="40" height="86" />
      </g>
      <g fill="#efdcc0">
        <rect x="18" y="210" width="26" height="6" /><rect x="18" y="226" width="26" height="6" /><rect x="18" y="242" width="26" height="6" />
        <rect x="116" y="192" width="34" height="6" /><rect x="116" y="208" width="34" height="6" /><rect x="116" y="224" width="34" height="6" /><rect x="116" y="240" width="34" height="6" />
        <rect x="226" y="224" width="38" height="6" /><rect x="226" y="240" width="38" height="6" />
        <rect x="340" y="244" width="38" height="6" />
