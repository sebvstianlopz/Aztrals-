        <rect x="40" y="440" width="70" height="4" /><rect x="250" y="470" width="90" height="4" /><rect x="120" y="530" width="60" height="4" /><rect x="300" y="560" width="70" height="4" />
      </g>
      <path d="M96 392 H196 L184 408 H108Z" fill="#f7f4ee" />
      <rect x="126" y="378" width="40" height="14" fill="#f7f4ee" />
      <rect x="132" y="382" width="26" height="5" fill="#2a5c99" />
