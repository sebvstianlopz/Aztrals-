      <rect y="344" width="400" height="40" fill="#255f7e" />
      <rect y="384" width="400" height="46" fill="#3a83a2" />
      <rect y="430" width="400" height="22" fill="#69aebf" />
      <path d="M0 452 Q50 444 100 452 T200 452 T300 452 T400 452 V462 H0Z" fill="#f7f0e4" />
      <rect y="462" width="400" height="138" fill="#e8cfa5" />
      <path d="M52 600 C58 540 70 500 92 470" stroke="#6b5640" stroke-width="7" fill="none" />
      <g fill="#5d7e57"><path d="M92 470 q-40 -6 -64 18 q34 -10 64 -18z" /><path d="M92 470 q30 -30 70 -22 q-40 4 -70 22z" /><path d="M92 470 q-10 -40 10 -64 q-6 34 -10 64z" /><path d="M92 470 q44 -2 62 28 q-30 -20 -62 -28z" /></g>
    </g>
  )}
  {place === 'culebra' && (
    <g>
      <rect width="400" height="600" fill="#d8ecec" />
      <ellipse cx="96" cy="120" rx="58" ry="14" fill="#edf6f5" />
      <ellipse cx="290" cy="80" rx="40" ry="10" fill="#edf6f5" />
      <path d="M0 312 C40 250 110 240 168 300 L168 312Z" fill="#6f9472" />
      <path d="M232 312 C270 262 340 246 400 280 V312Z" fill="#5a7f60" />
      <rect y="312" width="400" height="36" fill="#1f6f86" />
      <rect y="348" width="400" height="48" fill="#2f9aa6" />
      <rect y="396" width="400" height="44" fill="#6cc7c0" />
