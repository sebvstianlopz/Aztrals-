      <circle cx="92" cy="112" r="30" fill="#fbf6ea" />
      <path d="M180 330 C220 300 270 296 310 312 C340 300 380 304 400 318 V330Z" fill="#8ea6c2" />
      <rect y="330" width="400" height="80" fill="#2a5c99" />
      <rect y="410" width="400" height="90" fill="#346fb0" />
      <rect y="500" width="400" height="100" fill="#4384c4" />
