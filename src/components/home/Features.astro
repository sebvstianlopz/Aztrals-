---
// What the pairs are made of, as three columns of names at one size.
import { t } from '../../i18n';
import type { Lang } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="features grid wrap" aria-labelledby="features-title">
  <h2 id="features-title" class="title">{d.features.title}</h2>
  {d.features.groups.map((g, gi) => (
    <div class="group" style={`--col:${1 + gi * 3}`} data-reveal>
      <h3 class="group-name">{g.name}</h3>
      <ul role="list">
        {g.items.map(([name, desc]) => (
          <li tabindex="0" data-desc={desc}>{name}</li>
        ))}
      </ul>
      <p class="sum soft">{g.sum}</p>
    </div>
  ))}
  <p class="desc" aria-live="polite"></p>
</section>

<style>
  .features { padding-block: calc(var(--section) * 0.9); row-gap: 40px; }
  .title { grid-column: 1 / span 3; grid-row: 1; font-size: var(--step-lead); letter-spacing: -0.02em; margin-bottom: 56px; }
  .group { grid-row: 2; grid-column: var(--col) / span 3; font-size: var(--step-body); line-height: 1.25; }
  .group-name { font-size: inherit; font-weight: 500; letter-spacing: 0; margin-bottom: 1.25em; }
  .group ul { display: grid; gap: 0.35em; }
  .group li { color: var(--soft); cursor: default; transition: color var(--fast) var(--ease); width: fit-content; }
  .group li:hover, .group li:focus-visible { color: var(--ink); }
  .sum { display: none; }
  .desc { grid-row: 2; grid-column: 10 / span 3; align-self: start; font-size: var(--step-body); line-height: 1.4; min-height: 3em; }
  @media (max-width: 900px) {
    .title { grid-column: 1 / -1; margin-bottom: 8px; }
    .group { grid-row: auto; grid-column: 1 / -1; line-height: 1.4; }
    .group-name { margin-bottom: 0.6em; }
    .sum { display: block; margin-top: 0.8em; }
    .desc { display: none; }
  }
</style>

<script>
  const root = document.querySelector('.features');
  const out = root?.querySelector<HTMLElement>('.desc');
  root?.querySelectorAll<HTMLElement>('li[data-desc]').forEach((li) => {
    const show = () => out && (out.textContent = li.dataset.desc || '');
    li.addEventListener('mouseenter', show);
    li.addEventListener('focus', show);
  });
</script>
