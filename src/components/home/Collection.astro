---
import ProductTile from '../ProductTile.astro';
import { t, path } from '../../i18n';
import type { Lang } from '../../config/site';
import type { ClientProduct, Product } from '../../lib/products';
interface Props { lang: Lang; items: { client: ClientProduct; product: Product }[] }
const { lang, items } = Astro.props;
const d = t(lang);
---
<section class="collection section wrap" aria-labelledby="collection-title">
  <div class="heading" data-reveal>
    <p class="caps grey">{d.collection.kicker}</p>
    <h2 id="collection-title">{d.collection.title}</h2>
    <p class="caption">{d.collection.caption}</p>
  </div>
  <ul role="list" class="grid">
    {items.map(({ client, product }) => <ProductTile lang={lang} product={client} data={product.data} size="small" />)}
  </ul>
  <p class="all"><a class="btn outline" href={path(lang, 'shop')}>{d.collection.all}</a></p>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px var(--gap); margin: 0; }
  .all { display: flex; justify-content: center; margin-top: clamp(40px, 5vw, 64px); }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
