---
// A single centred link to the shop between the release spotlight and "Momentos".
import { t, path } from '../../i18n';
import type { Lang } from '../../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---
<div class="to-shop wrap" data-reveal>
  <a class="btn btn--ink" href={path(lang, 'shop')}>{d.close.cta} <span class="arrow" aria-hidden="true">→</span></a>
</div>

<style>
  .to-shop {
    display: flex;
    justify-content: center;
    padding-top: clamp(64px, 7vw, 112px);
  }
</style>
