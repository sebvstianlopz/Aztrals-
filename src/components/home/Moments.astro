---
import Shot from '../Shot.astro';
import Silhouette from '../Silhouette.astro';
import { t, path } from '../../i18n';
import { sitePhoto, type Product } from '../../lib/products';
import { tintColor } from '../../lib/swatches';
import type { Lang } from '../../config/site';

interface Props {
  lang: Lang;
  products: Product[];
}
const { lang, products } = Astro.props;
const d = t(lang).moments;
// Which model each moment shows. SAMPLE: match these to the real photos.
const plan = [
  { key: 'playa', model: 'culebra', tone: 'sand', body: '#11120d', flip: false },
  { key: 'surf', model: 'rincon', tone: 'night', body: '#565449', flip: true },
  { key: 'ciudad', model: 'condado', tone: 'stone', body: '#11120d', flip: true },
  { key: 'entreno', model: 'yunque', tone: 'sand', body: '#11120d', flip: false },
] as const;
const items = plan
  .map((m) => ({ ...m, product: products.find((p) => p.id === m.model) }))
  .filter((m) => m.product);
---
<section class="moments section wrap" id="momentos" aria-labelledby="moments-title">
  <div class="moments__head">
    <h2 id="moments-title" class="h2" data-reveal>{d.title}</h2>
    <p class="lede" data-reveal>{d.text}</p>
  </div>
  <ul class="moments__grid">
    {
      items.map((m, i) => {
        const prod = m.product!;
        const cw = prod.data.colorways[0];
        const copy = d.items[m.key];
        return (
          <li class={`moment moment--${i}`} data-reveal>
            <Shot photo={sitePhoto(m.key)} alt={`${copy.t}: ${prod.data.name}`} ratio="3 / 4" tone={m.tone} sizes="(min-width: 900px) 30vw, 92vw" class="moment__shot">
              <Silhouette class="moment__sil" body={m.body} lens={tintColor[cw.tint]} flip={m.flip} />
            </Shot>
            <h3 class="h3">{copy.t}</h3>
            <p class="muted">{copy.d}</p>
            <a class="link" href={path(lang, 'shop', prod.id)}>
              {d.wearing}: {prod.data.name} <span aria-hidden="true">→</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .moments {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: start;
  }
  .moments__head {
    position: sticky;
    top: 112px;
    display: grid;
    gap: 20px;
  }
  .moments__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px) clamp(16px, 2vw, 28px);
  }
  .moment {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .moment--1,
  .moment--3 {
    margin-top: clamp(48px, 10vw, 160px);
  }
  .moment :global(.moment__shot) {
    border-radius: var(--radius-tile);
    margin-bottom: 10px;
  }
  .moment__sil {
    position: absolute;
    inset: 12% 0 0;
    width: 100%;
    height: 88%;
  }
  /* Different crops of the stand-in figure, so the four pictures don't repeat. */
  .moment--0 .moment__sil {
    inset: 4% -14% 0 -2%;
    width: 116%;
    height: 96%;
  }
  .moment--1 .moment__sil {
    inset: 22% 0 0;
    height: 78%;
  }
  .moment--2 .moment__sil {
    inset: 0 0 0 -30%;
    width: 150%;
    height: 112%;
  }
  .moment p {
    max-width: 34ch;
  }
  @media (max-width: 900px) {
    .moments {
      grid-template-columns: 1fr;
    }
    .moments__head {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .moments__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .moment--1,
    .moment--3 {
      margin-top: 0;
    }
  }
</style>
