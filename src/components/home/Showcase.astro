---
// One band of four tall slices, one per season pair, at unequal widths.
import { t, path } from '../../i18n';
import type { Lang } from '../../config/site';
import { money, poster, variantName, type Product } from '../../lib/products';
import { lenses } from '../../lib/palette';
interface Props { lang: Lang; season: Product[] }
const { lang, season } = Astro.props;
const d = t(lang);
const grow = [5, 2, 3, 2];
const focus = ['30% 50%', '62% 50%', '28% 50%', '66% 50%'];
const panels = season.slice(0, 4).map((p, i) => {
  const v = p.data.variants[1] ?? p.data.variants[0];
  return { p, v, field: lenses[v.lens].field, grow: grow[i], focus: focus[i] };
});
---
<section class="showcase" aria-labelledby="showcase-title">
  <div class="grid wrap" data-reveal>
    <h2 id="showcase-title" class="title">{d.showcase.title}</h2>
  </div>
  <div class="band" data-reveal>
    {panels.map(({ p, v, field, grow, focus }, i) => (
      <a class="panel" href={`${path(lang, 'shop', p.id)}?v=${v.id}`} style={`--g:${grow};--field:${field}`}>
        <img src={poster(p.id, v.id)} alt={`${p.data.name}, ${variantName(v, lang)}`} width="1200" height="900" loading="lazy" style={`object-position:${focus}`} />
        {i === 0 && <span class="panel-title">{d.season}</span>}
        <span class="panel-label"><span>{p.data.name}</span><span class="num soft">{money(p.data.price, lang)}</span></span>
      </a>
    ))}
  </div>
  <p class="caption wrap" data-reveal><span>{d.showcase.caption}</span></p>
</section>

<style>
  .showcase { padding-top: var(--section); }
  .title { grid-column: 3 / span 8; font-size: var(--step-head); letter-spacing: -0.03em; margin-bottom: 64px; }
  .band { display: flex; height: 68svh; min-height: 420px; }
  .panel {
    position: relative; flex: var(--g) 1 0; min-width: 0; overflow: hidden; background: var(--field);
    text-decoration: none; transition: flex-grow 500ms var(--ease);
  }
  .panel img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.55); transition: transform 900ms var(--ease); }
  .panel-title { position: absolute; left: 24px; top: 24px; max-width: 8ch; font-size: var(--step-lead); line-height: 1.05; letter-spacing: -0.02em; font-weight: 500; }
  .panel-label { position: absolute; left: 24px; right: 24px; bottom: 20px; display: flex; justify-content: space-between; gap: 12px; font-size: var(--step-body); }
  .panel-label span:first-child { font-weight: 500; }
  @media (hover: hover) and (min-width: 901px) {
    .panel:hover { flex-grow: 6; }
    .panel:hover img { transform: scale(1.4); }
  }
  .caption { margin-top: 20px; max-width: calc(60ch + 2 * var(--margin)); }
  @media (max-width: 900px) {
    .title { grid-column: 1 / -1; margin-bottom: 32px; }
    .band { flex-wrap: wrap; height: 84svh; }
    .panel { flex: none; height: 50%; }
    .panel:nth-child(1), .panel:nth-child(4) { width: 64%; }
    .panel:nth-child(2), .panel:nth-child(3) { width: 36%; }
    .panel img { transform: scale(1.9); }
    .panel-label { left: 14px; right: 14px; bottom: 12px; flex-direction: column; gap: 0; }
    .panel-title { display: none; }
  }
</style>
