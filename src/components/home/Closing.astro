---
import { t } from '../../i18n';
import type { Lang } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="closing inverse wrap" aria-labelledby="closing-title">
  <h2 id="closing-title" class="title" data-reveal><span>{d.cta.title[0]}</span> <span>{d.cta.title[1]}</span></h2>
  <div class="base grid">
    <p class="text">{d.cta.text}</p>
    <a class="btn" href="#temporada">{d.cta.button}<span class="arrow" aria-hidden="true">↑</span></a>
  </div>
</section>

<style>
  .closing { background: var(--ink); color: var(--ground); min-height: 90svh; display: flex; flex-direction: column; justify-content: space-between; padding-top: clamp(64px, 9vw, 140px); padding-bottom: 40px; }
  .title { font-size: var(--step-display-2); font-weight: 500; letter-spacing: -0.045em; line-height: 0.92; }
  .title span { display: block; }
  .base { align-items: end; margin-top: 64px; }
  .text { grid-column: 1 / span 5; font-size: var(--step-lead); }
  .btn { grid-column: 10 / -1; justify-self: end; min-height: 56px; }
  .closing :global(.btn) { background: var(--accent); }
  @media (max-width: 900px) {
    .closing { min-height: 80svh; }
    .title { font-size: 10vw; }
    .text { grid-column: 1 / -1; font-size: var(--step-body); }
    .btn { grid-column: 1 / -1; justify-self: stretch; margin-top: 24px; }
  }
</style>
