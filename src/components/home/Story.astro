---
// First screen: the name, pinned, while the season's four pairs replace each other
// in front of the places they are named after.
import Place from '../Place.astro';
import { t, path } from '../../i18n';
import type { Lang } from '../../config/site';
import { money, poster, variantName, type Product } from '../../lib/products';
import { lenses } from '../../lib/palette';

interface Props { lang: Lang; season: Product[] }
const { lang, season } = Astro.props;
const d = t(lang);
const chapters = season.slice(0, 4).map((p) => {
  const v = p.data.variants[0];
  return {
    slug: p.id,
    name: p.data.name,
    place: p.data.place[lang],
    price: money(p.data.price, lang),
    variant: v,
    variantName: variantName(v, lang),
    field: lenses[v.lens].field,
    poster: poster(p.id, v.id),
    url: path(lang, 'shop', p.id),
    spec: { shape: p.data.shape, frame: v.frame, lens: v.lens },
  };
});
const places = ['condado', 'culebra', 'rincon', 'vieques'] as const;
---
<section class="story" id="temporada" data-active="0" style={`--n:${chapters.length};--field:${chapters[0].field}`} aria-labelledby="story-title">
  <div class="pin">
    <h1 class="name" id="story-title">Aztrals</h1>

    <div class="frame">
      {chapters.map((c, i) => (
        <div class="place" data-i={i} style={`--field:${c.field}`}>
          <Place place={places.includes(c.slug as any) ? (c.slug as any) : places[i % 4]} label={c.place} />
        </div>
      ))}
      {chapters.map((c, i) => (
        <img class="poster" data-i={i} src={c.poster} alt={`${c.name}, ${c.variantName}`} width="1200" height="900" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? 'auto' : 'high'} />
      ))}
    </div>
    <canvas class="stage" aria-hidden="true" data-specs={JSON.stringify(chapters.map((c) => c.spec))}></canvas>

    <div class="intro">
      <p class="sub">{d.hero.sub}</p>
      <ol class="chapters" aria-label={d.season}>
        {chapters.map((c, i) => (
          <li><a href={`#capitulo-${i}`} data-i={i}>{c.name}</a></li>
        ))}
      </ol>
    </div>

    <div class="buys">
      {chapters.map((c, i) => (
        <div class="buy" data-i={i}>
          <h2 class="buy-name">{c.name}</h2>
          <p class="buy-place soft">{c.place}</p>
          <p class="buy-variant small"><span class="num">{c.price}</span><span>{c.variantName}</span></p>
          <div class="buy-actions">
            <button type="button" class="btn" data-add={`${c.slug}|${c.variant.id}`} data-added={d.product.added}>{d.hero.add}</button>
            <a class="link small" href={`${c.url}?v=${c.variant.id}`}>{d.hero.view}<span class="arrow" aria-hidden="true"> →</span></a>
          </div>
        </div>
      ))}
    </div>
  </div>
  {chapters.map((_, i) => <div class="step" id={`capitulo-${i}`} data-i={i} style={`--i:${i}`}></div>)}
</section>

<style>
  .story { position: relative; background: var(--field); transition: background-color 900ms var(--ease); }
  :global(.js) .story { height: calc(var(--n) * 100svh); }
  .pin {
    position: sticky; top: 0; height: 100svh; min-height: 620px; overflow: hidden;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr); column-gap: var(--gap);
    padding-inline: var(--margin);
  }
  .step { position: absolute; left: 0; right: 0; top: calc(var(--i) * 100svh); height: 100svh; pointer-events: none; }

  .name {
    position: absolute; z-index: 4; left: 0; right: 0; top: clamp(76px, 9vh, 120px);
    font-size: var(--step-name); font-weight: 500; letter-spacing: -0.055em; line-height: 0.72;
    text-transform: uppercase; text-align: center; white-space: nowrap; color: var(--ink);
    padding-top: 0.04em;
  }

  .frame { position: relative; grid-row: 1; grid-column: 5 / span 4; margin-top: clamp(90px, 13vh, 130px); height: calc(100% - clamp(90px, 13vh, 130px)); z-index: 1; }
  .place { position: absolute; inset: 0; clip-path: inset(100% 0 0 0); transition: clip-path 1000ms var(--ease-in-out); }
  .place:first-child { clip-path: inset(0); }
  .place :global(svg) { width: 100%; height: 100%; }
  .poster { position: absolute; z-index: 2; left: -26%; width: 152%; max-width: none; top: 50%; transform: translateY(-50%); opacity: 0; pointer-events: none; }
  .poster[data-i='0'] { opacity: 1; }

  .stage { position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; top: clamp(90px, 13vh, 130px); width: 100%; height: calc(100% - clamp(90px, 13vh, 130px)); }
  :global(.live) .poster { display: none; }

  .intro { grid-row: 1; grid-column: 1 / span 3; align-self: end; padding-bottom: 32px; z-index: 4; display: grid; gap: 28px; }
  .sub { font-size: var(--step-body); font-weight: 500; max-width: 26ch; }
  .chapters { display: flex; flex-wrap: wrap; gap: 4px 18px; padding: 0; list-style: none; font-size: var(--step-small); }
  .chapters a { text-decoration: none; color: var(--soft); transition: color var(--fast) var(--ease); }
  .chapters a:hover { color: var(--ink); }

  .buys { grid-row: 1; grid-column: 10 / span 3; align-self: end; padding-bottom: 32px; z-index: 4; display: grid; }
  .buy { grid-area: 1 / 1; display: grid; gap: 6px; justify-items: start; opacity: 0; visibility: hidden; transform: translateY(12px); transition: none; }
  .buy-name { font-size: var(--step-lead); font-weight: 500; letter-spacing: -0.02em; }
  .buy-place { font-size: var(--step-small); max-width: 30ch; }
  .buy-variant { margin-top: 4px; display: flex; gap: 14px; }
  .buy-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 14px; }

  /* The active chapter */
  .story[data-active='0'] .buy[data-i='0'], .story[data-active='1'] .buy[data-i='1'], .story[data-active='2'] .buy[data-i='2'], .story[data-active='3'] .buy[data-i='3'] {
    opacity: 1; visibility: visible; transform: none; transition: opacity 500ms var(--ease) 250ms, transform 500ms var(--ease) 250ms;
  }
  .story[data-active='1'] .place[data-i='1'], .story[data-active='2'] .place[data-i='1'], .story[data-active='3'] .place[data-i='1'],
  .story[data-active='2'] .place[data-i='2'], .story[data-active='3'] .place[data-i='2'],
  .story[data-active='3'] .place[data-i='3'] { clip-path: inset(0); }
  .story[data-active='0'] .chapters a[data-i='0'], .story[data-active='1'] .chapters a[data-i='1'], .story[data-active='2'] .chapters a[data-i='2'], .story[data-active='3'] .chapters a[data-i='3'] { color: var(--ink); text-decoration: underline; text-underline-offset: 0.25em; }

  @media (max-width: 900px) {
    .pin { grid-template-rows: auto 1fr auto; min-height: 560px; }
    .name { top: 64px; font-size: 25.5vw; }
    .frame { grid-column: 1 / -1; grid-row: 2; margin-top: calc(64px + 9vw); height: auto; min-height: 0; }
    .stage { top: calc(64px + 9vw); bottom: auto; height: calc(100svh - 64px - 9vw - 190px); min-height: 300px; }
    .intro { display: none; }
    .buys { grid-column: 1 / -1; grid-row: 3; padding: 16px 0 calc(20px + env(safe-area-inset-bottom)); }
    .buy-place { display: none; }
    .buy-actions { margin-top: 8px; }
  }
</style>

<script>
  import { initStory } from '../../scripts/story';
  initStory();
</script>
