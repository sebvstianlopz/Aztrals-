---
// Every pair as one table at one type size: name, shape, lens tints, price.
import { t, path } from '../../i18n';
import type { Lang } from '../../config/site';
import { money, poster, type Product } from '../../lib/products';
import { lenses, shapeNames } from '../../lib/palette';
interface Props { lang: Lang; products: Product[] }
const { lang, products } = Astro.props;
const d = t(lang);
const groups = [
  { name: d.season, items: products.filter((p) => p.data.season) },
  { name: d.always, items: products.filter((p) => !p.data.season) },
];
---
<section class="lineup inverse-soft wrap" aria-labelledby="lineup-title">
  <h2 id="lineup-title" class="visually-hidden">{d.list.title}</h2>
  {groups.map((g) => (
    <div class="group">
      <h3 class="day">{g.name}</h3>
      <ul role="list">
        {g.items.map((p) => {
          const v = p.data.variants[0];
          const tints = [...new Set(p.data.variants.map((x) => x.lens))];
          return (
            <li style={`--field:${lenses[v.lens].field}`}>
              <a class="row" href={path(lang, 'shop', p.id)} data-poster={poster(p.id, v.id)}>
              <span class="cell name">{p.data.name}</span>
              <span class="cell shape">{shapeNames[p.data.shape][lang]}</span>
              <span class="cell tints">
                {tints.map((l) => <span class="dot" style={`--c:${lenses[l].hex}`} title={lenses[l].name[lang]}></span>)}
                <span class="tint-names">{tints.map((l) => lenses[l].name[lang]).join(', ')}</span>
              </span>
              <span class="cell price num">{money(p.data.price, lang)}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
  <p class="all"><a class="btn ink" href={path(lang, 'shop')}>{d.list.all}<span class="arrow" aria-hidden="true">→</span></a></p>
  <img class="peek" alt="" width="1200" height="900" aria-hidden="true" />
</section>

<style>
  .lineup { background: var(--surface); padding-block: calc(var(--section) * 0.8); position: relative; }
  .group + .group { margin-top: 72px; }
  .day { font-size: var(--step-lead); font-weight: 400; letter-spacing: -0.01em; line-height: 1.5; color: var(--accent); margin-bottom: 20px; }
  .row { position: relative; display: grid; grid-template-columns: 33% 33% 1fr auto; align-items: baseline; text-decoration: none; font-size: var(--step-lead); line-height: 1.5; letter-spacing: -0.01em; }
  .cell { min-width: 0; }
  .name { transition: color var(--fast) var(--ease); }
  .row:hover .name, .row:focus-visible .name { color: var(--accent); }
  .tints { display: flex; align-items: center; gap: 8px; }
  .tints .dot { width: 0.7em; height: 0.7em; }
  .tint-names { margin-left: 8px; font-size: var(--step-small); color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .price { text-align: right; }
  .all { margin-top: 64px; }
  .peek {
    position: fixed; left: 0; top: 0; width: 300px; height: auto; pointer-events: none; z-index: 30;
    background: var(--field); opacity: 0; transform: translate(-9999px, 0);
    transition: opacity 250ms var(--ease);
  }
  .peek.on { opacity: 1; }
  @media (max-width: 900px) {
    .row { grid-template-columns: 1fr auto; row-gap: 0; padding-bottom: 18px; }
    .name { grid-column: 1; }
    .price { grid-column: 2; grid-row: 1; font-size: var(--step-body); }
    .shape, .tints { grid-column: 1 / -1; font-size: var(--step-small); color: var(--soft); line-height: 1.4; }
    .shape { grid-row: 2; }
    .tints { grid-row: 3; }
    .tint-names { margin-left: 4px; }
    .peek { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.lineup');
  const peek = root?.querySelector<HTMLImageElement>('.peek');
  if (root && peek && matchMedia('(hover: hover) and (min-width: 901px)').matches) {
    let x = 0, y = 0, raf = 0;
    const move = () => {
      peek.style.transform = `translate(${x + 24}px, ${y - 110}px)`;
      raf = 0;
    };
    root.querySelectorAll<HTMLElement>('.row').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        peek.src = row.dataset.poster || '';
        peek.style.setProperty('--field', row.style.getPropertyValue('--field'));
        peek.classList.add('on');
      });
      row.addEventListener('mouseleave', () => peek.classList.remove('on'));
      row.addEventListener('mousemove', (e) => {
        x = e.clientX;
        y = e.clientY;
        if (!raf) raf = requestAnimationFrame(move);
      });
    });
  }
</script>
