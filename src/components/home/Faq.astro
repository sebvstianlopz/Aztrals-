---
// Questions large on the left, answers beside them. Every answer open.
import { t } from '../../i18n';
import type { Lang } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="faq wrap" id="preguntas" aria-labelledby="faq-title">
  <div class="row grid">
    <h2 id="faq-title" class="q soft">{d.faq.title}</h2>
  </div>
  {d.faq.items.map(([q, a]) => (
    <div class="row grid" data-reveal>
      <h3 class="q">{q}</h3>
      <p class="a">{a}</p>
    </div>
  ))}
</section>

<style>
  .faq { padding-bottom: var(--section); display: grid; gap: clamp(56px, 6vw, 84px); }
  .row { align-items: baseline; }
  .q { grid-column: 1 / span 6; font-size: var(--step-head); font-weight: 500; line-height: 1.1; letter-spacing: -0.025em; }
  .a { grid-column: 8 / -1; max-width: 40ch; font-size: var(--step-body); line-height: 1.55; }
  @media (max-width: 900px) {
    .faq { gap: 48px; }
    .q, .a { grid-column: 1 / -1; }
    .a { margin-top: 12px; }
  }
</style>
