---
import Icon from '../Icon.astro';
import { t } from '../../i18n';
import type { Lang } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="faq section wrap" id="ayuda" aria-labelledby="faq-title">
  <div class="heading" data-reveal>
    <p class="caps grey">{d.faq.kicker}</p>
    <h2 id="faq-title">{d.faq.title}</h2>
  </div>
  <div class="list">
    {d.faq.items.map(([q, a]) => (
      <details>
        <summary><span>{q}</span><Icon name="plus" class="plus" /></summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .list { max-width: 820px; margin-inline: auto; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 22px 0; cursor: pointer; list-style: none; font-family: var(--serif); font-size: 1.375rem; line-height: 1.25; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { opacity: 0.7; }
  .faq :global(.plus) { width: 18px; height: 18px; flex: none; transition: transform 400ms var(--ease); }
  details[open] :global(.plus) { transform: rotate(45deg); }
  details p { padding: 0 48px 24px 0; color: var(--grey); max-width: 64ch; }
</style>
