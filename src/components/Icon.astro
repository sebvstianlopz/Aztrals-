---
// Thin line icons, drawn at 24×24 with a 1.25 stroke.
interface Props { name: 'bag' | 'menu' | 'close' | 'sun' | 'truck' | 'return' | 'card' | 'plus' | 'arrow'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'bag' && <><path d="M5 8h14l-1 12H6L5 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></>}
  {name === 'menu' && <><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></>}
  {name === 'close' && <><path d="M6 6l12 12" /><path d="M18 6L6 18" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>}
  {name === 'truck' && <><path d="M2 6h12v10H2z" /><path d="M14 9h4l3 3v4h-7" /><circle cx="6" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" /></>}
  {name === 'return' && <><path d="M4 9h11a5 5 0 0 1 0 10H8" /><path d="M8 5L4 9l4 4" /></>}
  {name === 'card' && <><rect x="3" y="6" width="18" height="12" rx="1" /><path d="M3 10h18" /><path d="M7 15h4" /></>}
  {name === 'plus' && <><path d="M12 5v14" /><path d="M5 12h14" /></>}
  {name === 'arrow' && <><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></>}
</svg>
