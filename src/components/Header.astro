---
import { t, path } from '../i18n';
import type { Lang } from '../config/site';
interface Props { lang: Lang; alternate: string }
const { lang, alternate } = Astro.props;
const d = t(lang);
const home = path(lang, 'home');
---
<header class="site-header wrap">
  <a class="wordmark" href={home} aria-label="Aztrals">Aztrals</a>
  <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
    <ul role="list">
      <li class="wide"><a href={`${home}#temporada`}>{d.nav.season}</a></li>
      <li><a href={path(lang, 'shop')}>{d.nav.shop}</a></li>
      <li class="wide"><a href={`${home}#lentes`}>{d.nav.lens}</a></li>
      <li class="wide"><a href={`${home}#preguntas`}>{d.nav.help}</a></li>
      <li><a href={alternate} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'}>{lang === 'es' ? 'EN' : 'ES'}<span class="visually-hidden"> — {d.switchTo}</span></a></li>
      <li>
        <a href="#bolsa" class="bag-link" data-bag-open>
          {d.nav.bag}<span class="bag-count num" data-bag-count></span>
        </a>
      </li>
    </ul>
  </nav>
</header>
<a href="#bolsa" class="bag-float btn ink" data-bag-open aria-label={d.bag.open}>
  {d.nav.bag}<span class="num" data-bag-count></span>
</a>

<style>
  .site-header {
    position: absolute; inset: 0 0 auto 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    height: var(--header);
  }
  .wordmark { font-size: var(--step-body); font-weight: 600; letter-spacing: -0.01em; text-decoration: none; }
  ul { display: flex; gap: clamp(14px, 2.2vw, 36px); margin: 0; }
  nav a { text-decoration: none; font-size: var(--step-small); padding-block: 10px; display: inline-block; transition: color var(--fast) var(--ease); }
  nav a:hover { color: var(--accent); }
  .bag-count:not(:empty)::before { content: ' '; }
  .bag-count:not(:empty) { font-weight: 600; }
  @media (max-width: 760px) {
    .wide { display: none; }
  }
  .bag-float {
    position: fixed; right: var(--margin); bottom: calc(var(--margin) + env(safe-area-inset-bottom)); z-index: 40;
    min-height: 48px; padding: 0 20px;
    opacity: 0; visibility: hidden; transform: translateY(16px); pointer-events: none;
    transition: opacity var(--slow) var(--ease), transform var(--slow) var(--ease), background-color var(--fast) var(--ease), visibility 0s var(--slow);
  }
  .bag-float span:not(:empty)::before { content: '·'; margin-right: 0.45em; opacity: 0.6; }
  :global(html.has-bag) .bag-float { opacity: 1; visibility: visible; transform: none; pointer-events: auto; transition-delay: 0s; }
</style>
