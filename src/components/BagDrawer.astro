---
import Icon from './Icon.astro';
import { t, path } from '../i18n';
import type { Lang } from '../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<dialog id="bag" class="bag" aria-labelledby="bag-title">
  <div class="bag-inner">
    <div class="bag-head">
      <h2 id="bag-title" class="caps">{d.bag.title} (<span class="num" data-bag-count>0</span>)</h2>
      <button type="button" class="bag-close" data-bag-close aria-label={d.bag.close}><Icon name="close" /></button>
    </div>
    <div data-bag-empty class="bag-empty">
      <p class="empty-text">{d.bag.empty}</p>
      <a class="btn" href={`${path(lang, 'home')}#temporada`}>{d.bag.emptyCta}</a>
    </div>
    <ul role="list" class="bag-lines" data-bag-lines></ul>
    <div class="bag-foot" data-bag-foot hidden>
      <p class="bag-total"><span class="caps">{d.bag.subtotal}</span><span class="num" data-bag-total></span></p>
      <a class="btn" href="#" data-bag-send target="_blank" rel="noopener">{d.bag.send}</a>
      <p class="note">{d.bag.note}</p>
    </div>
  </div>
</dialog>

<style is:global>
  .bag {
    margin: 0 0 0 auto; height: 100dvh; max-height: none; width: min(440px, 100vw); max-width: none;
    padding: 0; border: 0; background: var(--white); color: var(--ink);
  }
  .bag::backdrop { background: rgb(13 13 13 / 0.4); }
  .motion .bag[open] { animation: bag-in 500ms var(--ease); }
  .motion .bag[open]::backdrop { animation: fade-in 400ms var(--ease); }
  @keyframes bag-in { from { transform: translateX(100%); } }
  @keyframes fade-in { from { opacity: 0; } }
  .bag-inner { display: flex; flex-direction: column; height: 100%; padding: 0 24px calc(24px + env(safe-area-inset-bottom)); }
  .bag-head { display: flex; justify-content: space-between; align-items: center; height: var(--header); border-bottom: 1px solid var(--line); margin-inline: -24px; padding-inline: 24px; }
  .bag-head h2 { font-family: var(--sans); }
  .bag-close { background: none; border: 0; padding: 8px; margin-right: -8px; display: inline-flex; transition: opacity var(--fast) var(--ease); }
  .bag-close:hover { opacity: 0.6; }
  .bag-empty { display: grid; gap: 20px; justify-items: start; padding-top: 32px; }
  .bag-empty[hidden] { display: none; }
  .empty-text { font-family: var(--serif); font-size: 1.5rem; }
  .bag-lines { flex: 1; overflow: auto; margin: 0; }
  .bag-line { display: grid; grid-template-columns: 96px 1fr auto; gap: 16px; align-items: start; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .bag-pic { display: block; background: var(--soft); aspect-ratio: 1; }
  .bag-pic img { width: 100%; height: 100%; object-fit: contain; }
  .bag-info { display: grid; gap: 2px; }
  .bag-name { font-family: var(--serif); font-size: 1.375rem; line-height: 1.1; text-decoration: none; }
  .bag-name:hover { opacity: 0.6; }
  .bag-info .soft { color: var(--grey); font-size: var(--t-small); }
  .bag-qty { display: flex; align-items: center; margin-top: 10px; }
  .bag-qty button[data-q] { width: 32px; height: 32px; border: 1px solid var(--line); background: var(--white); transition: border-color var(--fast) var(--ease); }
  .bag-qty button[data-q]:hover { border-color: var(--ink); }
  .bag-qty output { min-width: 32px; text-align: center; font-size: var(--t-small); }
  .bag-qty .bag-remove { width: auto; border: 0; margin-left: 14px; padding: 0; font-size: var(--t-caps); letter-spacing: 0.1em; text-transform: uppercase; color: var(--grey); text-decoration: underline; text-underline-offset: 3px; }
  .bag-qty .bag-remove:hover { color: var(--ink); border: 0; }
  .bag-price { font-size: var(--t-small); }
  .bag-foot { display: grid; gap: 14px; padding-top: 20px; }
  .bag-foot[hidden] { display: none; }
  .bag-total { display: flex; justify-content: space-between; align-items: baseline; font-size: 1.125rem; }
  .note { font-size: var(--t-small); color: var(--grey); }
</style>
