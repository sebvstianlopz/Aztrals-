---
import { t, path } from '../i18n';
import type { Lang } from '../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<dialog id="bag" class="bag" aria-labelledby="bag-title">
  <div class="bag-inner">
    <div class="bag-head">
      <h2 id="bag-title" class="lead">{d.bag.title}</h2>
      <button type="button" class="bag-close" data-bag-close>{d.bag.close}</button>
    </div>
    <div data-bag-empty class="bag-empty">
      <p>{d.bag.empty}</p>
      <a class="btn" href={`${path(lang, 'home')}#temporada`}>{d.bag.emptyCta}</a>
    </div>
    <ul role="list" class="bag-lines" data-bag-lines></ul>
    <div class="bag-foot" data-bag-foot hidden>
      <p class="bag-total lead"><span>{d.bag.subtotal}</span><span class="num" data-bag-total></span></p>
      <a class="btn" href="#" data-bag-send target="_blank" rel="noopener">{d.bag.send}</a>
      <p class="small soft">{d.bag.note}</p>
    </div>
  </div>
</dialog>

<style is:global>
  .bag {
    margin: 0 0 0 auto; height: 100dvh; max-height: none; width: min(460px, 100vw); max-width: none;
    padding: 0; border: 0; background: var(--ground); color: var(--ink);
    box-shadow: -20px 0 60px rgb(18 22 28 / 0.18); /* taste-skill-ignore: dialog overlay */
  }
  .bag::backdrop { background: rgb(18 22 28 / 0.35); }
  .motion .bag[open] { animation: bag-in 520ms var(--ease); }
  .motion .bag[open]::backdrop { animation: fade-in 400ms var(--ease); }
  @keyframes bag-in { from { transform: translateX(100%); } }
  @keyframes fade-in { from { opacity: 0; } }
  .bag-inner { display: flex; flex-direction: column; height: 100%; padding: 20px var(--margin) calc(20px + env(safe-area-inset-bottom)); }
  .bag-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; }
  .bag-close { background: none; border: 0; padding: 10px 0; font-size: var(--step-small); text-decoration: underline; text-underline-offset: 0.2em; }
  .bag-close:hover { color: var(--accent); }
  .bag-empty { display: grid; gap: 20px; justify-items: start; padding-top: 24px; }
  .bag-empty[hidden] { display: none; }
  .bag-lines { flex: 1; overflow: auto; display: grid; align-content: start; gap: 12px; margin: 0; }
  .bag-line { display: grid; grid-template-columns: 112px 1fr auto; gap: 16px; align-items: start; padding: 0 0 12px; }
  .bag-pic { display: block; background: var(--field); aspect-ratio: 4 / 3; }
  .bag-pic img { width: 100%; height: 100%; object-fit: cover; }
  .bag-info { display: grid; gap: 2px; }
  .bag-name { font-weight: 500; font-size: var(--step-body); text-decoration: none; }
  .bag-name:hover { color: var(--accent); }
  .bag-qty { display: flex; align-items: center; gap: 4px; margin-top: 8px; }
  .bag-qty button[data-q] { width: 36px; height: 36px; border: 0; background: var(--surface); font-size: var(--step-body); transition: background-color var(--fast) var(--ease); }
  .bag-qty button[data-q]:hover { background: #dcd9d1; }
  .bag-qty output { min-width: 28px; text-align: center; }
  .bag-qty .bag-remove { width: auto; background: none; margin-left: 10px; padding: 0; text-decoration: underline; text-underline-offset: 0.2em; color: var(--soft); }
  .bag-qty .bag-remove:hover { background: none; color: var(--accent); }
  .bag-price { font-weight: 500; }
  .bag-foot { display: grid; gap: 14px; padding-top: 16px; background: var(--ground); }
  .bag-foot[hidden] { display: none; }
  .bag-total { display: flex; justify-content: space-between; }
</style>
