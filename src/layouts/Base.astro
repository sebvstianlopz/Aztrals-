---
import '@fontsource-variable/archivo/wdth.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BagDrawer from '../components/BagDrawer.astro';
import { t, asset, path } from '../i18n';
import { site, type Lang } from '../config/site';
import { getProducts } from '../lib/products';
import { frameColor, tintColor } from '../lib/swatches';
import type { Catalog } from '../lib/checkout';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Same page in the other language, as a path. */
  alternate: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { lang, title, description, alternate, jsonLd, noindex = false } = Astro.props;
const d = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(alternate, Astro.site);
const esUrl = lang === 'es' ? canonical : alt;
const enUrl = lang === 'en' ? canonical : alt;

// Everything the bag needs to know about the products, embedded once per page.
const products = await getProducts();
const catalog: Catalog = {
  shop: site.shopDomain,
  currency: site.currency,
  locale: d.locale,
  products: Object.fromEntries(
    products.map((p) => [
      p.id,
      {
        name: p.data.name,
        price: p.data.price,
        handle: p.data.shopifyHandle,
        url: path(lang, 'shop', p.id),
        colorways: Object.fromEntries(
          p.data.colorways.map((c) => [
            c.id,
            { name: c.name[lang], variant: c.shopifyVariantId, frame: frameColor[c.frame], tint: tintColor[c.tint] },
          ]),
        ),
      },
    ]),
  ),
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es-PR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <meta name="theme-color" content="#f1eee9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'es' ? 'es_PR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        var root = document.documentElement;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          setTimeout(function () {
            if (!root.classList.contains('motion-ready')) root.classList.remove('motion');
          }, 3000);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main" data-inert-with-bag>{d.skip}</a>
    <Header lang={lang} alternate={alternate} />
    <main id="main" data-inert-with-bag>
      <slot />
    </main>
    <Footer lang={lang} alternate={alternate} />
    <BagDrawer lang={lang} />
    <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
    <script>
      import '../scripts/bag';
      import '../scripts/motion';
      import '../scripts/filters';
    </script>
  </body>
</html>

<style>
  .skip:not(:focus) {
    clip-path: inset(50%);
    width: 1px;
    height: 1px; /* taste-skill-ignore: visually hidden skip link, not a rule */
    overflow: hidden;
    white-space: nowrap;
  }
  .skip {
    position: absolute;
    left: 16px;
    top: 12px;
    z-index: 110;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bone);
    text-decoration: none;
  }
</style>
