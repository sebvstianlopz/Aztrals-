---
import Base from '../layouts/Base.astro';
import ProductTile from '../components/ProductTile.astro';
import { t, path, asset } from '../i18n';
import { site, type Lang } from '../config/site';
import { getProducts, money, poster, variantName, type Product } from '../lib/products';
import { frames, lenses, shapeNames } from '../lib/palette';
import { singleMessage, waLink } from '../lib/whatsapp';

interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const d = t(lang);
const data = p.data;
const v0 = data.variants[0];
const url = new URL(path(lang, 'shop', p.id), Astro.site).href;
const others = (await getProducts()).filter((x) => x.id !== p.id);
// Related: same season first, then the nearest prices.
const related = others.sort((a, b) => Number(b.data.season === data.season) - Number(a.data.season === data.season) || Math.abs(a.data.price - data.price) - Math.abs(b.data.price - data.price)).slice(0, 3);
const variants = data.variants.map((v) => ({
  id: v.id,
  name: variantName(v, lang),
  poster: poster(p.id, v.id),
  field: lenses[v.lens].field,
  wa: waLink(singleMessage(data.name, variantName(v, lang), data.price, `${url}?v=${v.id}`, lang)),
  spec: { shape: data.shape, frame: v.frame, lens: v.lens },
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${site.name} ${data.name}`,
  description: data.description[lang],
  brand: { '@type': 'Brand', name: site.name },
  image: data.variants.map((v) => new URL(asset(`products/${p.id}/${v.id}.webp`), Astro.site).href),
  offers: { '@type': 'Offer', price: data.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url },
};
---
<Base
  lang={lang}
  title={`${data.name} · ${shapeNames[data.shape][lang]} · Aztrals`}
  description={`${data.description[lang]} ${money(data.price, lang)}.`}
  alternate={path(lang === 'es' ? 'en' : 'es', 'shop', p.id)}
  image={`products/${p.id}/${v0.id}.webp`}
  jsonLd={jsonLd}
>
  <article class="product wrap grid" style={`--field:${variants[0].field}`}>
    <div class="viewer">
      <div class="box">
        <img class="poster" src={variants[0].poster} alt={`${data.name}, ${variants[0].name}`} width="1200" height="900" fetchpriority="high" />
        <canvas class="stage" tabindex="0" aria-label={d.product.turn} data-variants={JSON.stringify(variants.map((v) => ({ id: v.id, spec: v.spec })))}></canvas>
      </div>
      <div class="turns">
        <p class="small soft">{d.product.turn}</p>
        <span class="turn-buttons">
          <button type="button" class="btn quiet" data-turn="-1" aria-label={d.product.turnLeft}>←</button>
          <button type="button" class="btn quiet" data-turn="1" aria-label={d.product.turnRight}>→</button>
        </span>
      </div>
    </div>

    <div class="info" data-reveal>
      <a class="link small back" href={path(lang, 'shop')}>← {d.product.back}</a>
      <h1 class="name">{data.name}</h1>
      <p class="place soft">{data.place[lang]}</p>
      <p class="price num">{money(data.price, lang)}</p>
      <p class="desc">{data.description[lang]}</p>

      <fieldset class="variants">
        <legend class="small soft">{d.product.variant}: <span class="vname">{variants[0].name}</span></legend>
        <div class="vlist">
          {data.variants.map((v, i) => (
            <label class="v" title={variants[i].name}>
              <input type="radio" name="variant" value={v.id} checked={i === 0} data-poster={variants[i].poster} data-field={variants[i].field} data-wa={variants[i].wa} data-name={variants[i].name} />
              <span class="sw" style={`--f:${frames[v.frame].hex};--l:${lenses[v.lens].hex}`}></span>
              <span class="visually-hidden">{variants[i].name}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="buy">
        <label class="qty">
          <span class="small soft">{d.product.qty}</span>
          <span class="stepper">
            <button type="button" data-step="-1" aria-label={d.bag.less}>−</button>
            <input id="qty" type="number" inputmode="numeric" min="1" max="20" value="1" />
            <button type="button" data-step="1" aria-label={d.bag.more}>+</button>
          </span>
        </label>
        <button type="button" class="btn add" data-add={`${p.id}|${v0.id}`} data-qty="#qty" data-added={d.product.added}>{d.product.add}</button>
        <a class="link wa" href={variants[0].wa} target="_blank" rel="noopener">{d.product.buyNow}</a>
      </div>

      <dl class="specs">
        <div><dt>{d.product.shape}</dt><dd>{shapeNames[data.shape][lang]}</dd></div>
        <div><dt>{d.product.lens}</dt><dd>{data.polarized ? d.product.polarized : d.product.uv}, {d.product.material[data.lensMaterial]}</dd></div>
        <div><dt>{d.product.size}</dt><dd class="num">{d.product.sizeText(...data.size)}</dd></div>
        <div><dt>{d.product.fit}</dt><dd>{d.product.fitName[data.fit]}</dd></div>
        <div><dt>{d.product.included}</dt><dd>{d.product.includedText}</dd></div>
      </dl>
      <p class="small soft">{d.product.delivery}</p>
    </div>
  </article>

  <section class="related wrap" aria-labelledby="related-title">
    <h2 id="related-title" class="rtitle">{d.product.related}</h2>
    <ul role="list" class="tiles">
      {related.map((r) => <ProductTile lang={lang} product={r} />)}
    </ul>
  </section>
</Base>

<style>
  .product { padding-top: calc(var(--header) + 8px); padding-bottom: var(--section); row-gap: 32px; align-items: start; }
  .viewer { grid-column: 1 / span 7; position: sticky; top: 16px; }
  .box { position: relative; background: var(--field); height: min(82svh, 760px); min-height: 380px; transition: background-color 600ms var(--ease); overflow: hidden; }
  .poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transform: scale(1.1); }
  :global(.live) .poster { display: none; }
  .stage { position: absolute; inset: 0; width: 100%; height: 100%; }
  .turns { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 12px; }
  .turn-buttons { display: flex; gap: 6px; }
  .turn-buttons .btn { min-height: 44px; width: 52px; padding: 0; font-size: var(--step-body); }
  .info { grid-column: 9 / -1; display: grid; gap: 14px; padding-top: clamp(16px, 4vw, 48px); }
  .back { justify-self: start; text-decoration: none; }
  .name { font-size: var(--step-head); letter-spacing: -0.035em; line-height: 0.95; margin-top: 12px; }
  .place { font-size: var(--step-body); }
  .price { font-size: var(--step-lead); font-weight: 500; }
  .desc { max-width: 46ch; }
  .variants { border: 0; padding: 0; margin: 10px 0 0; }
  .variants legend { padding: 0; margin-bottom: 10px; }
  .vname { color: var(--ink); }
  .vlist { display: flex; gap: 10px; }
  .v { cursor: pointer; }
  .v input { position: absolute; opacity: 0; pointer-events: none; }
  .sw { display: block; width: 44px; height: 44px; border-radius: 50%; background: var(--l); border: 11px solid var(--f); transition: transform var(--fast) var(--ease); }
  .v:hover .sw { transform: scale(1.08); }
  .v input:checked + .sw { outline: 2px solid var(--ink); outline-offset: 3px; }
  .v input:focus-visible + .sw { outline: 2px solid var(--accent); outline-offset: 3px; }
  .buy { display: flex; flex-wrap: wrap; align-items: end; gap: 14px 16px; margin-top: 10px; }
  .qty { display: grid; gap: 4px; }
  .stepper { display: flex; }
  .stepper button { width: 44px; height: 52px; border: 0; background: var(--surface); font-size: var(--step-body); transition: background-color var(--fast) var(--ease); }
  .stepper button:hover { background: #dcd9d1; }
  .stepper input { width: 52px; height: 52px; border: 0; background: var(--surface); text-align: center; -moz-appearance: textfield; appearance: textfield; font-variant-numeric: tabular-nums; }
  .stepper input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .add { flex: 1 1 200px; }
  .wa { flex-basis: 100%; }
  .specs { display: grid; gap: 10px; margin-top: 18px; }
  .specs div { display: grid; grid-template-columns: 9em 1fr; gap: 12px; }
  .specs dt { color: var(--soft); }
  .related { padding-bottom: var(--section); }
  .rtitle { font-size: var(--step-head); letter-spacing: -0.03em; margin-bottom: 40px; }
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px var(--gap); padding: 0; }
  @media (max-width: 900px) {
    .viewer, .info { grid-column: 1 / -1; }
    .viewer { position: relative; top: 0; margin-inline: calc(-1 * var(--margin)); }
    .turns { padding-inline: var(--margin); }
    .box { height: 64svh; }
    .info { padding-top: 0; }
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 12px; }
    .tiles :global(.tile:nth-child(3)) { display: none; }
    .specs div { grid-template-columns: 7.5em 1fr; }
  }
</style>

<script>
  import { initSwatches } from '../scripts/swatches';
  import { initViewer } from '../scripts/viewer';
  initSwatches();
  initViewer();
</script>
