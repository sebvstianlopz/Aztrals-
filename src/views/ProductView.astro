---
import Base from '../layouts/Base.astro';
import ProductTile from '../components/ProductTile.astro';
import Spin from '../components/Spin.astro';
import Icon from '../components/Icon.astro';
import { t, path } from '../i18n';
import { site, type Lang } from '../config/site';
import { clientCatalog, getProducts, money, type Product } from '../lib/products';
import { gallery } from '../lib/media';
import { frames, lenses, shapeNames } from '../lib/palette';
import { singleMessage, waLink } from '../lib/whatsapp';

interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const d = t(lang);
const data = p.data;
const clients = await clientCatalog();
const c = clients.find((x) => x.slug === p.id)!;
const url = new URL(path(lang, 'shop', p.id), Astro.site).href;
const photos = await gallery(p.id);
const all = await getProducts();
const related = all
  .filter((x) => x.id !== p.id)
  .sort((a, b) => Number(b.data.season === data.season) - Number(a.data.season === data.season) || Math.abs(a.data.price - data.price) - Math.abs(b.data.price - data.price))
  .slice(0, 4);
const variants = c.variants.map((v) => ({
  ...v,
  label: v.name[lang],
  wa: waLink(singleMessage(data.name, v.name[lang], data.price, `${url}?v=${v.id}`, lang)),
}));
const v0 = variants[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${site.name} ${data.name}`,
  description: data.description[lang],
  brand: { '@type': 'Brand', name: site.name },
  image: variants.map((v) => new URL(v.pics.main, Astro.site).href),
  offers: { '@type': 'Offer', price: data.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url },
};
---
<Base lang={lang} title={`${data.name} · ${shapeNames[data.shape][lang]} · Aztrals`} description={`${data.description[lang]} ${money(data.price, lang)}.`} alternate={path(lang === 'es' ? 'en' : 'es', 'shop', p.id)} image={v0.pics.main} jsonLd={jsonLd}>
  <nav class="crumbs wrap caps grey" aria-label="Breadcrumb">
    <a href={path(lang, 'shop')}>{d.product.back}</a> <span aria-hidden="true">/</span> <span aria-current="page">{data.name}</span>
  </nav>
  <article class="product wrap" data-slug={p.id}>
    <div class="viewer">
      <div class="stage">
        <Spin frames={v0.pics.spin} alt={`${data.name}, ${v0.label}`} label={d.product.view360} hint={d.featured.turn} eager />
        <img class="still" alt="" hidden />
      </div>
      {photos.length > 0 && (
        <div class="gallery" role="group" aria-label={lang === 'es' ? 'Fotos' : 'Photos'}>
          <button type="button" class="g360 caps" aria-pressed="true">360°</button>
          {photos.map((g, i) => (
            <button type="button" class="gthumb" aria-pressed="false" data-large={g.large} aria-label={`${lang === 'es' ? 'Foto' : 'Photo'} ${i + 1}`}>
              <img src={g.thumb} alt="" width="120" height="120" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="info">
      <h1 class="name">{data.name}</h1>
      <p class="place">{data.place[lang]}</p>
      <p class="price num">{money(data.price, lang)}</p>

      <fieldset class="variants">
        <legend class="caps">{d.product.variant}: <span class="vname grey">{v0.label}</span></legend>
        <div class="vlist">
          {variants.map((v, i) => (
            <label class="v" title={v.label}>
              <input type="radio" name="variant" value={v.id} checked={i === 0} data-frames={JSON.stringify(v.pics.spin)} data-wa={v.wa} data-name={v.label} />
              <span class="swatch" style={`--f:${frames[v.frame].hex};--l:${lenses[v.lens].hex}`}></span>
              <span class="visually-hidden">{v.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="buy">
        <div class="stepper" role="group" aria-label={d.product.qty}>
          <button type="button" data-step="-1" aria-label={d.bag.less}>−</button>
          <input id="qty" type="number" inputmode="numeric" min="1" max="20" value="1" aria-label={d.product.qty} />
          <button type="button" data-step="1" aria-label={d.bag.more}>+</button>
        </div>
        <button type="button" class="btn add" data-add={`${p.id}|${v0.id}`} data-qty="#qty" data-added={d.product.added}><span>{d.product.add}</span><Icon name="bag" /></button>
      </div>
      <a class="link-caps wa" href={v0.wa} target="_blank" rel="noopener">{d.product.buyNow}</a>
      <p class="ship">{d.product.shipNote}</p>

      <div class="acc">
        <details open>
          <summary class="caps">{d.product.acc.details}<Icon name="plus" class="plus" /></summary>
          <div class="body">
            <p>{data.description[lang]}</p>
            <dl>
              <div><dt>{d.product.shape}</dt><dd>{shapeNames[data.shape][lang]}</dd></div>
              <div><dt>{d.product.lens}</dt><dd>{data.polarized ? d.product.polarized : d.product.uv}, {d.product.material[data.lensMaterial]}</dd></div>
              <div><dt>{d.product.included}</dt><dd>{d.product.includedText}</dd></div>
            </dl>
          </div>
        </details>
        <details>
          <summary class="caps">{d.product.acc.size}<Icon name="plus" class="plus" /></summary>
          <div class="body">
            <dl>
              <div><dt>{d.product.size}</dt><dd class="num">{d.product.sizeText(...data.size)}</dd></div>
              <div><dt>{d.product.fit}</dt><dd>{d.product.fitName[data.fit]}</dd></div>
            </dl>
            <p class="grey">{d.product.sizeHelp}</p>
          </div>
        </details>
        <details>
          <summary class="caps">{d.product.acc.delivery}<Icon name="plus" class="plus" /></summary>
          <div class="body"><p>{d.product.delivery}</p></div>
        </details>
      </div>
    </div>
  </article>

  <section class="related section wrap" aria-labelledby="related-title">
    <div class="heading"><h2 id="related-title">{d.product.related}</h2></div>
    <ul role="list" class="tiles">
      {related.map((r) => <ProductTile lang={lang} product={clients.find((x) => x.slug === r.id)!} data={r.data} />)}
    </ul>
  </section>
</Base>

<style>
  .crumbs { padding-top: 24px; display: flex; gap: 10px; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--ink); }
  .product { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 96px); padding-top: 24px; align-items: start; }
  .viewer { position: sticky; top: calc(var(--header) + 24px); }
  .stage { position: relative; }
  .still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: var(--white); }
  .gallery { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
  .gallery button { width: 72px; height: 72px; padding: 0; border: 1px solid var(--line); background: var(--soft); transition: border-color var(--fast) var(--ease); }
  .gallery button[aria-pressed='true'] { border-color: var(--ink); }
  .gallery img { width: 100%; height: 100%; object-fit: cover; }
  .info { display: grid; gap: 16px; padding-top: clamp(8px, 3vw, 40px); max-width: 460px; }
  .name { font-family: var(--sans); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.2; }
  .place { color: var(--grey); letter-spacing: 0.04em; }
  .price { font-size: 1.375rem; letter-spacing: 0.06em; }
  .variants { border: 0; padding: 0; margin: 4px 0 0; }
  .variants legend { padding: 0; margin-bottom: 12px; }
  .vname { text-transform: none; letter-spacing: 0.02em; font-weight: 400; }
  .vlist { display: flex; gap: 6px; }
  .v { cursor: pointer; padding: 3px; border: 1px solid transparent; transition: border-color var(--fast) var(--ease); }
  .v:hover { border-color: var(--line); }
  .v:has(input:checked) { border-color: var(--ink); }
  .v:has(input:focus-visible) { outline: 1px solid var(--ink); outline-offset: 2px; }
  .v input { position: absolute; opacity: 0; pointer-events: none; }
  .buy { display: flex; gap: 12px; margin-top: 8px; }
  .stepper { display: flex; border: 1px solid var(--line); }
  .stepper button { width: 40px; border: 0; background: var(--white); font-size: 1.125rem; transition: background-color var(--fast) var(--ease); }
  .stepper button:hover { background: var(--soft); }
  .stepper input { width: 40px; border: 0; text-align: center; -moz-appearance: textfield; appearance: textfield; font-variant-numeric: tabular-nums; }
  .stepper input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .add { flex: 1; justify-content: space-between; }
  .wa { justify-self: start; }
  .ship { font-size: var(--t-small); }
  .acc { margin-top: 12px; border-top: 1px solid var(--line); }
  .acc details { border-bottom: 1px solid var(--line); }
  .acc summary { display: flex; justify-content: space-between; align-items: center; padding: 18px 0; cursor: pointer; list-style: none; color: var(--grey); font-weight: 400; transition: color var(--fast) var(--ease); }
  .acc summary::-webkit-details-marker { display: none; }
  .acc summary:hover, .acc details[open] summary { color: var(--ink); }
  .acc :global(.plus) { width: 16px; height: 16px; transition: transform 400ms var(--ease); }
  .acc details[open] :global(.plus) { transform: rotate(45deg); }
  .body { display: grid; gap: 14px; padding-bottom: 20px; font-size: var(--t-small); }
  dl { display: grid; gap: 8px; }
  dl div { display: grid; grid-template-columns: 8em 1fr; gap: 12px; }
  dt { color: var(--grey); }
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px var(--gap); margin: 0; }
  @media (max-width: 1000px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    .product { grid-template-columns: 1fr; }
    .viewer { position: relative; top: 0; }
    .info { max-width: none; }
  }
</style>

<script>
  import { initSwatches } from '../scripts/swatches';
  initSwatches(document.querySelector('.related')!);

  const product = document.querySelector<HTMLElement>('.product');
  if (product) {
    const spin = product.querySelector<HTMLElement>('.spin');
    const still = product.querySelector<HTMLImageElement>('.still')!;
    const add = product.querySelector<HTMLButtonElement>('.add')!;
    const wa = product.querySelector<HTMLAnchorElement>('.wa')!;
    const vname = product.querySelector<HTMLElement>('.vname')!;
    const radios = product.querySelectorAll<HTMLInputElement>('input[name="variant"]');
    const choose = (input: HTMLInputElement, push = true) => {
      input.checked = true;
      add.dataset.add = `${product.dataset.slug}|${input.value}`;
      wa.href = input.dataset.wa || wa.href;
      vname.textContent = input.dataset.name || '';
      spin?.dispatchEvent(new CustomEvent('spin:set', { detail: { frames: JSON.parse(input.dataset.frames || '[]'), alt: input.dataset.name } }));
      if (push) {
        const u = new URL(location.href);
        u.searchParams.set('v', input.value);
        history.replaceState(null, '', u);
      }
    };
    radios.forEach((r) => r.addEventListener('change', () => choose(r)));
    const wanted = new URL(location.href).searchParams.get('v');
    const start = Array.from(radios).find((r) => r.value === wanted);
    if (start && start !== radios[0]) choose(start, false);

    const qty = product.querySelector<HTMLInputElement>('#qty')!;
    product.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        qty.value = String(Math.max(1, Math.min(20, (Number(qty.value) || 1) + Number(b.dataset.step))));
      }),
    );

    // Gallery: photos replace the 360° view until "360°" is chosen again.
    const gbuttons = product.querySelectorAll<HTMLButtonElement>('.gallery button');
    gbuttons.forEach((b) =>
      b.addEventListener('click', () => {
        gbuttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        if (b.dataset.large) {
          still.src = b.dataset.large;
          still.hidden = false;
        } else still.hidden = true;
      }),
    );
  }
</script>
